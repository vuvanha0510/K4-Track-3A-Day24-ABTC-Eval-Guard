# Required: chọn một trong hai provider
OPENAI_API_KEY=
GEMINI_API_KEY=

# Gemini qua OpenAI-compat endpoint
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GENERATION_MODEL=gemini-3.5-flash-lite
JUDGE_MODEL=gemini-3.5-flash-lite
RAGAS_CHAT_MODEL=gemini-3.5-flash-lite
RAGAS_EMBED_MODEL=gemini-embedding-001
RAGAS_RPM_LIMIT=9

# Free-tier rate limits: retry 429 + giãn cách giữa các mẫu latency
LLM_MAX_RETRIES=6
LLM_RETRY_BASE_S=8
LATENCY_SAMPLE_INTERVAL_S=4.5

# Optional: HuggingFace token (only if using HF Inference Endpoints)
HF_TOKEN=
